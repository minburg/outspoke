<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto-backup rules for Android 11 (API 30) and below; API 31+ uses data_extraction_rules.xml.
   Referenced from AndroidManifest.xml as android:fullBackupContent.
   This is an allowlist: only files/datastore (preferences) is backed up. The models and suggestion
   packs under filesDir are re-downloaded. Without the include, auto-backup walks all of filesDir.
-->
<full-backup-content>
    <!-- DataStore preferences: files/datastore/outspoke_prefs.preferences_pb -->
    <include domain="file" path="datastore"/>
</full-backup-content>
