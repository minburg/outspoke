<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup/restore rules for Android 12 (API 31) and above; older releases use backup_rules.xml.
   Referenced from AndroidManifest.xml as android:dataExtractionRules.
   Both sections are allowlists and both need their include: a section that is absent falls back
   to backing up everything, including the re-downloadable models and suggestion packs.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore preferences: files/datastore/outspoke_prefs.preferences_pb -->
        <include domain="file" path="datastore"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore"/>
    </device-transfer>
</data-extraction-rules>
