    <!-- Mikrofon-Kalibrierung -->
    <string name="nav_title_calib">Mikrofonkalibrierung</string>
    <string name="calib_score_format">Hochton %1$d %%  ·  SNR %2$d dB</string>
    <string name="calib_subtitle">Wähle das Mikrofon mit der klarsten Hochtonwiedergabe. Das Sprachmodell benötigt diese Details, um kurze Wörter wie „Danke“ sauber zu erkennen.</string>
    <string name="calib_instructions">Warte auf die rote Anzeige am jeweiligen Mikrofon und sage dann deutlich „Danke“. Das beste Mikrofon wird automatisch ausgewählt.</string>
    <string name="calib_start">Kalibrierung starten</string>
    <string name="calib_mic_of">Mikrofon %1$d von %2$d</string>
    <string name="calib_get_ready">Bereitmachen – gleich „Danke“ sagen</string>
    <string name="calib_speak_now">Jetzt „Danke“ sagen</string>
    <string name="calib_done">Kalibrierung abgeschlossen</string>
    <string name="calib_best">Bestes Mikrofon</string>
    <string name="calib_saved">Als bevorzugtes Mikrofon gespeichert</string>
    <string name="calib_run_again">Erneut kalibrieren</string>
    <string name="calib_no_mics">Keine Mikrofone gefunden.</string>
    <string name="calib_current">Aktuell</string>

    <!-- Wortvorschläge -->
    <string name="pref_suggestion_bar_title">Wortvorschläge</string>
    <string name="pref_suggestion_bar_subtitle">Zeigt nach jedem abgeschlossenen Diktat alternative Wörter für das Wort unter dem Cursor an – Phonetik und Sprachmodell arbeiten komplett lokal auf dem Gerät. Funktioniert offline. Sprachpakete werden separat heruntergeladen, um die App klein zu halten.</string>
    <string name="pref_suggestion_bar_enabled">Aktiviert</string>
    <string name="pref_suggestion_bar_disabled">Deaktiviert</string>
    <string name="pref_suggestion_bar_languages_title">Korrektursprachen</string>
    <string name="pref_suggestion_bar_languages_subtitle">Lade die Sprachen herunter, in denen du diktierst. Heruntergeladene Sprachen sind automatisch aktiv; entferne das Häkchen, um eine Sprache zu deaktivieren. Vorschläge stammen nur aus ausgewählten Sprachen.</string>
    <string name="pref_suggestion_bar_no_language">Keine aktive Sprache mit heruntergeladenen Daten – Vorschläge erscheinen erst, wenn mindestens eine Sprache heruntergeladen wurde.</string>
    <string name="suggestion_lang_download">Herunterladen</string>
    <string name="suggestion_lang_cancel">Abbrechen</string>
    <string name="suggestion_lang_delete">Löschen</string>
    <string name="suggestion_lang_retry">Erneut versuchen</string>
    <string name="cd_dismiss_suggestion_bar">Vorschläge ausblenden</string>

    <string name="cd_insert_space">Leerzeichen einfügen</string>
    <string name="pref_trailing_space_title">Leerzeichen nach Diktat</string>
    <string name="pref_trailing_space_summary">Fügt automatisch ein Leerzeichen ein, sobald die Aufnahme beendet und die Transkription abgeschlossen ist.</string>

    <string name="status_no_speech">Nichts erkannt – bitte erneut versuchen</string>
