    <!-- Preferences screen -->
    <string name="pref_trigger_mode_title">Auslösemodus</string>
    <string name="pref_trigger_mode_subtitle">Legt fest, wie die Sprachaufnahme gestartet und beendet wird.</string>
    <string name="pref_trigger_hold">Gedrückt halten</string>
    <string name="pref_trigger_tap_toggle">Antippen zum Umschalten</string>
    <string name="pref_delete_title">Löschtaste</string>
    <string name="pref_delete_subtitle">Legt fest, was das Papierkorb-Symbol auf der Tastatur löscht. Mit „Letzter Satz“
        wird nur der letzte Satz vor dem Cursor entfernt, damit lange Texte nicht versehentlich gelöscht werden.
    </string>
    <string name="pref_delete_all">Gesamter Text</string>
    <string name="pref_delete_last_sentence">Letzter Satz</string>
    <string name="pref_vad_title">Sprachaktivitätserkennung (VAD)</string>
    <string name="pref_vad_subtitle">Nutzt Silero VAD, um Stille und Hintergrundgeräusche vor der Transkription
        herauszufiltern. Nur deaktivieren, wenn der Satzanfang abgeschnitten wird oder die Erkennung leer bleibt.
    </string>
    <string name="pref_postprocessing_title">Transkript-Nachbearbeitung</string>
    <string name="pref_postprocessing_subtitle">Entfernt Füllwörter (äh, ähm, hmm), glättet Stottern und bereinigt
        Wortwiederholungen, die das Modell gelegentlich erzeugt. Deaktivieren, um die unveränderte Rohausgabe zu
        erhalten – hilfreich zur Fehlersuche, falls Wörter verschluckt oder verändert werden.
    </string>
    <string name="pref_postprocessing_disabled_raw">Deaktiviert (Rohausgabe)</string>
    <string name="pref_tutorial_title">Tastatur-Einführung</string>
    <string name="pref_tutorial_subtitle">Zeigt die Schritt-für-Schritt-Erklärung beim nächsten Öffnen der Tastatur
        erneut an.
    </string>
    <string name="pref_tutorial_reset">Einführung erneut anzeigen</string>

    <!-- Model screen -->
    <string name="model_screen_title">Spracherkennungsmodelle</string>
    <string name="model_screen_subtitle">Lade ein Modell herunter und tippe auf „Aktivieren“, um es für die
        Transkription zu nutzen. Es ist immer nur ein Modell gleichzeitig geladen.
    </string>
    <string name="model_size_format">~%d MB</string>
    <string name="model_active_label">Aktives Modell</string>
    <string name="model_download_failed">Download fehlgeschlagen oder Datei beschädigt</string>
    <string name="dialog_delete_title">Löschen bestätigen</string>
    <string name="dialog_delete_message">Möchtest du dieses Modell wirklich löschen? Dieser Vorgang kann nicht
        rückgängig gemacht werden.
    </string>
    <string name="dialog_mobile_data_title">Über mobile Daten herunterladen?</string>
    <string name="dialog_mobile_data_message">Dieses Modell ist ~%d MB groß. Der Download verbraucht mobile Daten.
        Verbinde dich mit einem WLAN, um zusätzliche Kosten zu vermeiden.
    </string>

