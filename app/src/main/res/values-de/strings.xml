    <!-- First-run keyboard tutorial -->
    <string name="tutorial_talk_button_title">Sprechtaste (Mitte)</string>
    <string name="tutorial_talk_button_desc">Gedrückt halten zum Aufnehmen, loslassen zum Transkribieren. Nach oben
        ziehen und loslassen, um freihändig weiterzusprechen. Im Tipp-Modus: einmal tippen zum Starten, erneut tippen
        zum Stoppen.
    </string>
    <string name="tutorial_switch_keyboard_title">Tastatur wechseln (oben rechts)</string>
    <string name="tutorial_switch_keyboard_desc">Wechselt zurück zur vorherigen Tastatur.</string>
    <string name="tutorial_space_title">Leerzeichen (daneben)</string>
    <string name="tutorial_space_desc">Fügt ein Leerzeichen ein – diese Tastatur hat keine klassische Leertaste. Eine
        laufende Aufnahme wird dabei nicht unterbrochen.
    </string>
    <string name="tutorial_delete_all_title">Löschen (ganz links)</string>
    <string name="tutorial_delete_all_desc">Löscht den letzten Satz – oder je nach Einstellung das gesamte Textfeld.</string>
    <string name="tutorial_delete_word_title">Wort löschen (links vom Mikrofon)</string>
    <string name="tutorial_delete_word_desc">Löscht das letzte Wort.</string>
    <string name="tutorial_delete_char_title">Zeichen löschen (rechts vom Mikrofon)</string>
    <string name="tutorial_delete_char_desc">Löscht das letzte Zeichen.</string>
    <string name="tutorial_enter_title">Eingabe / Aktion (ganz rechts)</string>
    <string name="tutorial_enter_desc">Führt die jeweilige Aktion aus: Senden, Suchen, Los oder Zeilenumbruch.
    </string>
    <string name="tutorial_skip">Überspringen</string>
    <string name="tutorial_next">Weiter</string>
    <string name="tutorial_dismiss">Verstanden!</string>
    <!-- Preferences · microphone section -->
    <string name="pref_mic_title">Mikrofon</string>
    <string name="pref_mic_subtitle">Kalibrieren, um das klarste Mikrofon für kurze Wörter wie „Danke“ zu wählen.</string>
    <string name="pref_mic_calibrate">Mikrofone kalibrieren</string>
    <string name="pref_raw_mic_title">Roh-Mikrofon (ohne Echokompensation)</string>
    <string name="pref_raw_mic_subtitle">Umgeht die systemseitige Echokompensation und Rauschunterdrückung. Aktivieren,
        wenn Ton über den eigenen Gerätelautsprecher transkribiert werden soll (z. B. eine Sprachnachricht auf
        Lautsprecher) – andernfalls filtert das System den Lautsprecherton heraus und erkennt nur Stille. In lauten
        Umgebungen etwas störanfälliger.
    </string>

